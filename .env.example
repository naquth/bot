# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Application (client) ID, same page as above
CLIENT_ID=

# Optional: set this while developing to register slash commands
# instantly to a single server instead of globally (takes up to 1h).
GUILD_ID=

# Accent color used in embeds (hex, no #)
BOT_COLOR=5c5cff

# --- Global Voice addon ---
# No configuration needed! Voice is bridged in-process (single bot, no
# external relay server) via src/voice/VoiceRelayBus.js. Both servers
# just need to run /globalvoice connect with the same room ID.

# --- Image addon (optional) ---
# Requires a Cloudflare R2 bucket. See README for setup steps.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Comma-separated Discord user IDs allowed to use bot-admin-only commands
# (e.g. /pet admin). Leave blank to disable those commands for everyone.
BOT_ADMIN_IDS=

# --- Quest addon (optional) ---
# Comma-separated URLs of APIs that return Discord Quests data in the
# same shape Discord's own quest feature uses. This addon does not
# fetch from Discord directly — it needs a compatible third-party API.
# Leave blank to disable /quest entirely.
QUEST_API_URLS=

# --- Social Alerts addon (optional) ---
# YouTube: works without a key using public RSS feeds, but an API key
# gets you the channel's display name/thumbnail automatically.
YOUTUBE_API_KEY=
# TikTok/Instagram polling uses RSSHub (self-hosted or public instance).
# Default is the public https://rsshub.app if left blank (rate-limited;
# self-hosting your own RSSHub instance is recommended for reliability).
RSSHUB_URL=

# --- Pro (Subdomain) addon (optional) ---
# Requires a Cloudflare-managed domain. Get the API token from
# Cloudflare Dashboard > My Profile > API Tokens (Zone:DNS:Edit
# permission on the target zone). Zone ID is on the domain's overview page.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_DOMAIN=
MAX_SUBDOMAINS_PER_USER=5

# --- Music addon (optional) ---
# Requires a running Lavalink server (https://github.com/lavalink-devs/Lavalink).
# Comma-separated if you're running more than one node.
LAVALINK_HOSTS=localhost
LAVALINK_PORTS=2333
LAVALINK_PASSWORDS=youshallnotpass
LAVALINK_SECURE=false
MUSIC_DEFAULT_PLATFORM=ytsearch
MUSIC_PLAYLIST_LIMIT=10

# --- Economy addon (optional) ---
ECONOMY_DAILY_COOLDOWN=86400
ECONOMY_BEG_COOLDOWN=3600
ECONOMY_WORK_COOLDOWN=28800
ECONOMY_ROB_COOLDOWN=10800
ECONOMY_HACK_COOLDOWN=7200
KYTH_BURN_ANNOUNCE_CHANNEL_ID=
GUILD_STOCK_REQUIRED_MEMBERS=1000

# --- Dashboard API addon (optional) ---
# Powers a REST API for your own web dashboard. Leave API_SECRET blank
# to disable the API entirely. Keep this secret as protected as your
# bot token — anyone with it can read/write every guild's settings.
# Reuses BOT_ADMIN_IDS (set above) for the owner-only guard.
API_SECRET=
API_PORT=3001
API_CORS_ORIGIN=*
# Optional: lets /music play resolve open.spotify.com links.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- AI addon (optional) ---
# Comma-separated Google Gemini API keys (from https://aistudio.google.com/apikey).
# Multiple keys are rotated round-robin to spread out free-tier rate limits.
GEMINI_API_KEYS=
AI_MODEL=gemini-2.5-flash
AI_IMAGEN_MODEL=gemini-2.5-flash-image-preview
AI_PERSONA_PROMPT=
AI_PER_MINUTE_LIMIT=60
AI_COOLDOWN_REQUESTS=3
AI_COOLDOWN_WINDOW_SEC=60
AI_HISTORY_LENGTH=10
